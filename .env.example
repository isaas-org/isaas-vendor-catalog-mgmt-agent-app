# Environment variables read by the server. Export them before running; no .env file is loaded automatically.

# Base URL of isaas-vendor-catalog-mgmt-backend.
BACKEND_API_URL=http://localhost:8082
# Shared service key for the backend (not enforced by the backend yet).
BACKEND_API_KEY=

# stdio for a local agent client, streamable-http to run as a standalone server.
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8092
